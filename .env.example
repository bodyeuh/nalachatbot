# Salin file ini menjadi .env.local untuk uji coba di komputer.
# Di Vercel, isi nilai yang sama lewat Settings > Environment Variables.

# === PILIH SALAH SATU PROVIDER ===

# Opsi 1: Z.ai (tersedia model gratis, mis. glm-4-flash)
ZAI_API_KEY=
ZAI_MODEL=glm-4-flash
# Opsional: ganti base URL jika provider Z.ai-mu berbeda
# ZAI_API_BASE=https://api.z.ai/api/paas/v4

# Opsi 2: Provider kompatibel OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
